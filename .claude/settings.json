{
  "enabledMcpjsonServers": ["chrome-devtools"],
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx vite:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx pwa-assets-generator:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git show:*)",
      "Bash(curl -s http://localhost:*)",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
